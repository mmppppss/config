/* ═══════════════════════════════════════
   ROFI — which-key (caelestia-shell × gruvbox)
   Lista de keybinds recursiva, estilo nvim
   ═══════════════════════════════════════ */
configuration {
  show-icons: false;
  font: "Hack Nerd Font Mono 9";
  modi: "dmenu";
  location: 0;
}

* {
  bg: #1d1d1df2;
  bg-alt: #3c3836;
  fg: #ebdbb2;
  fg-dim: #a89984;
  accent: #d79921;
  border: 1px solid;
  border-radius: 10px;
  background-color: transparent;
  text-color: @fg;
}

window {
  background-color: @bg;
  border: @border;
  border-color: #59443a;
  border-radius: 10px;
  width: 640px;
  padding: 10px;
}

mainbox {
  children: [ inputbar, message, listview ];
  spacing: 10px;
}

inputbar {
  background-color: transparent;
  padding: 4px 10px;
  border: @border;
  border-color: #59443a;
  border-radius: 8px;
  children: [ prompt, entry ];
  spacing: 8px;
}
prompt { text-color: @accent; }
entry { placeholder: "Filtrar keybind…"; placeholder-color: @fg-dim; }

message {
  background-color: transparent;
  text-color: @fg-dim;
  padding: 2px 10px;
}

listview {
  lines: 12;
  columns: 1;
  spacing: 3px;
  scrollbar: false;
  dynamic: true;
}

element {
  padding: 7px 10px;
  border-radius: 8px;
  orientation: horizontal;
}
element normal.normal { background-color: transparent; text-color: @fg; }
element alternate.normal { background-color: transparent; text-color: @fg; }
element selected.normal {
  background-color: @bg-alt;
  text-color: @accent;
  border: none;
}